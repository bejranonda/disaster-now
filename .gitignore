node_modules/
# the collector's output is published by the deploy job, never committed (it is out of date the next hour)
public/data/live/
# big downloads for research stay in the session scratchpad; only small derived files are committed
research/cache/
*.tmp
# secrets: .env and every copy or backup of it; only the template is committed
.env
.env.*
!.env.example
# Cloudflare: wrangler's local state and its local secrets file
.wrangler/
.dev.vars
.dev.vars.*
.DS_Store
__pycache__/
