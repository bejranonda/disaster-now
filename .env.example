# Copy to .env (git-ignored) and fill in. Never commit .env. Nothing here is needed to run the page locally.
# The port on 127.0.0.1 the page is served on (FloodWatch uses 3000 on the same server).
WEB_PORT=8090
# Seconds between collector runs; at least 600 (the collector refuses less).
COLLECT_EVERY=900
# Only if Docker Hub rate-limits this host: the same image from Amazon's public mirror.
# NODE_IMAGE=public.ecr.aws/docker/library/node:22-alpine
# Only for `--profile public`: the token of a Cloudflare tunnel whose public hostname points to http://web:8080.
# CLOUDFLARE_TUNNEL_TOKEN=
