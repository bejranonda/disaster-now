# ==============================================================================
# Disaster Now (ภัยรอบบ้าน ตอนนี้) — environment template
# ==============================================================================
# Copy to .env (git-ignored) and fill in:  cp .env.example .env
# Never commit .env. NOTHING here is needed to run the page: `npm run serve` works with an empty .env.
# Check what is set without printing any value:  node tools/env-check.mjs   (add --probe to test the keys live)
# Who reads what: docker-compose.yml passes each service ONLY the variables it lists (least privilege);
# local `node tools/*.mjs` runs read this file through tools/env.mjs. The page in the browser never sees any of it.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. The server stack (docker compose; docs/SERVER.md)
# ------------------------------------------------------------------------------
# The port on 127.0.0.1 the page is served on (FloodWatch uses 3000 on the same server).
WEB_PORT=8090
# Seconds between collector runs; at least 600 (the collector refuses less).
COLLECT_EVERY=900
# Only if Docker Hub rate-limits this host: the same image from Amazon's public mirror.
# NODE_IMAGE=public.ecr.aws/docker/library/node:22-alpine
# Shown in the collector's User-Agent so agencies can reach a person (GUIDELINES §5: honest identification).
CONTACT_EMAIL=

# ------------------------------------------------------------------------------
# 2. Public address and Cloudflare (docs/CLOUDFLARE.md)
# ------------------------------------------------------------------------------
# The public hostname. risk.autobahn.bot is the owner's pick (2026-10-23); now.autobahn.bot was the earlier suggestion.
PUBLIC_HOST=risk.autobahn.bot
CLOUDFLARE_DOMAIN=autobahn.bot
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
# Deploys the Worker (wrangler) and runs tools/cf-setup.mjs. Scope it to this job — Account: Workers Scripts:Edit,
# Workers KV Storage:Edit; Zone autobahn.bot: Workers Routes:Edit, DNS:Edit (for the custom domain). Never commit it.
CLOUDFLARE_API_TOKEN=
# The KV namespace that holds the collector's live files for the Worker (created by tools/cf-setup.mjs; not secret,
# the same id is written into wrangler.jsonc). Empty = the collector writes local files only.
CF_KV_NAMESPACE_ID=
# A separate token with ONLY "Workers KV Storage:Edit" for the collector's uploads (recommended). Empty = the collector
# falls back to CLOUDFLARE_API_TOKEN.
CF_KV_TOKEN=
# Only for the tunnel route (`docker compose --profile public up -d`; docs/CLOUDFLARE.md option C): the token of a
# tunnel made FOR THIS SITE whose public hostname points to http://web:8080. NEVER paste FloodWatch's tunnel token
# here: a second connector would join FloodWatch's tunnel and Cloudflare would split FloodWatch's visitors between
# the two origins.
CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------------------------
# 3. Optional data keys — v0.3 runs WITHOUT them (docs/SOURCES.md). Collector only, sent in headers, never to the page.
# ------------------------------------------------------------------------------
TMD_API_KEY=
GISTDA_API_KEY=
GISTDA_API_ENDPOINT=https://api-gateway.gistda.or.th/api/2.0/resources/features/flood/7days
# Open-Meteo is keyless for non-commercial use; a key only for a paid plan (KI-011).
OPEN_METEO_API_KEY=
# Google Flood Forecasting (Flood Hub): not used yet (ROADMAP v0.5); kept because FloodWatch's pilot key may be reused.
GOOGLE_FLOOD_API_KEY=

# ------------------------------------------------------------------------------
# 4. GLM (Zhipu AI) — optional, OFF the visitor's path (docs/AI.md). The page works identically without it.
# ------------------------------------------------------------------------------
# What it does here: the collector translates TMD's Thai warnings into English for the English page (checked: every
# number and time kept, no Thai left, no reassurance added; the Thai notice stays the official one), and dev tools
# (tools/ai-review-copy.mjs) give a first reading of the Thai copy before the human review. GLM never sees a
# visitor's position or typed text, and never writes a level, a number or advice.
AI_ENABLED=0
AI_PROVIDER=glm
GLM_API_KEY=
# glm-5.3-flash: the family's tested model (FloodWatch D-030: always reasons; "low" effort answers in ~1–5 s).
GLM_MODEL=glm-5.3-flash
# open.bigmodel.cn is where FloodWatch's key works; a key from z.ai needs https://api.z.ai/api/paas/v4/chat/completions
GLM_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
# A hard cap on GLM calls per UTC day by the collector (a warning is translated once, then reused from the last file).
AI_DAILY_CALLS=200
