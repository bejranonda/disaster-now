{
  "name": "disaster-now",
  "private": true,
  "version": "0.7.0",
  "description": "ภัยรอบบ้าน · Thai Risk (code name disaster-now): one page that shows every hazard at a point in Thailand — heat, PM2.5 and other pollution, UV, rain, wind, river level, flash flood, landslide, earthquake, fire, storms — now and for the next 72 hours, from free and open sources",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "serve": "node tools/serve.mjs",
    "collect": "node tools/collect.mjs",
    "smoke": "node tools/smoke.mjs",
    "build:tambon": "python3 tools/build_tambon.py",
    "check:advice": "node tools/check-advice.mjs",
    "check:docs": "node tools/check-docs.mjs",
    "env:check": "node tools/env-check.mjs",
    "preflight": "node tools/preflight.mjs",
    "cf:setup": "node tools/cf-setup.mjs",
    "cf:dev": "npx --yes wrangler@4.148.0 dev --local",
    "cf:deploy": "node tools/cf-deploy.mjs",
    "ai:review-copy": "node tools/ai-review-copy.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright-core": "^1.56.1"
  }
}
